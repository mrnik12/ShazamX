<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>ShazamX</string>
    <key>entry</key>
    <dict>
        <key>cell</key>
        <string>PSLinkCell</string>
        <key>label</key>
        <string>ShazamX</string>
        <key>icon</key>
        <string>/Library/Application Support/LegacyShazam/SettingsIcon.png</string>
    </dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>Song recognition requires an internet connection. Turn this off to use Shazam's original behavior.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>Enabled</string>
            <key>defaults</key>
            <string>org.legacyshazam.settings</string>
            <key>key</key>
            <string>Enabled</string>
            <key>default</key>
            <true/>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>Netrun is the default. If recognition isn't working, switch to Render and try again.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSegmentCell</string>
            <key>label</key>
            <string>Recognition Server</string>
            <key>defaults</key>
            <string>org.legacyshazam.settings</string>
            <key>key</key>
            <string>RecognitionServer</string>
            <key>default</key>
            <string>netrun</string>
            <key>validTitles</key>
            <array>
                <string>Netrun</string>
                <string>Render</string>
            </array>
            <key>validValues</key>
            <array>
                <string>netrun</string>
                <string>render</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
